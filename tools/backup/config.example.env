# TEMPLATE ONLY. Keep real credentials outside git; source locally with `set -a`.
# Pre-create this approved offsite mounted directory with mode 0700.
BACKUP_ROOT=/mnt/approved-union-backup
# Public encryption key ONLY on the backup machine. Full 40/64 hex fingerprint.
BACKUP_RECIPIENT=REPLACE_WITH_VERIFIED_PUBLIC_KEY_FINGERPRINT
PGSERVICE=union_backup
PGSERVICEFILE=/secure/union-backup/pg_service.conf
PGPASSFILE=/secure/union-backup/pgpass
PGSSLROOTCERT=/secure/union-backup/supabase-ca.crt
RCLONE_CONFIG=/secure/union-backup/rclone.conf
# Whole project S3 root includes every bucket. No customer path/filter here.
BACKUP_STORAGE_SOURCE=union-source:
