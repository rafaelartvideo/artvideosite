<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(?:js|css|png|jpg|jpeg|gif|svg|webp|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS even when the cPanel toggle is unavailable.
  # X-Forwarded-Proto avoids redirect loops if the request passes through a proxy.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]

  # Preserve links created before the public site and CRM were split.
  # These redirects only run on the public ArtVideo domain; the same .htaccess
  # can therefore be deployed safely to both hosts.
  RewriteCond %{HTTP_HOST} ^(?:www\.)?eletronicaartvideo\.com\.br$ [NC]
  RewriteRule ^admin(?:/.*)?$ https://testeteste.com.br%{REQUEST_URI} [R=301,L,NE]

  RewriteCond %{HTTP_HOST} ^(?:www\.)?eletronicaartvideo\.com\.br$ [NC]
  RewriteRule ^captura(?:/.*)?$ https://testeteste.com.br%{REQUEST_URI} [R=301,L,NE]

  RewriteCond %{HTTP_HOST} ^(?:www\.)?eletronicaartvideo\.com\.br$ [NC]
  RewriteRule ^editar-os-mobile/?$ https://testeteste.com.br%{REQUEST_URI} [R=301,L,NE]

  RewriteCond %{HTTP_HOST} ^(?:www\.)?eletronicaartvideo\.com\.br$ [NC]
  RewriteRule ^assinatura(?:/.*)?$ https://testeteste.com.br%{REQUEST_URI} [R=301,L,NE]

  RewriteCond %{HTTP_HOST} ^(?:www\.)?eletronicaartvideo\.com\.br$ [NC]
  RewriteRule ^verificar-documento(?:/.*)?$ https://testeteste.com.br%{REQUEST_URI} [R=301,L,NE]

  # Build assets are content-hashed. If an old tab requests an asset that was
  # removed by a newer deploy, let Apache return a real 404 instead of serving
  # index.html with the wrong MIME type. The app can then recover/reload cleanly.
  RewriteRule ^assets/ - [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
