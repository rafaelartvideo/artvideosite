<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(?:js|css|png|jpg|jpeg|gif|svg|webp|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Legacy CRM domain: preserve path and query string while moving to Union World.
  RewriteCond %{HTTP_HOST} ^(?:www\.)?testeteste\.com\.br$ [NC]
  RewriteRule ^ https://unionworld.com.br%{REQUEST_URI} [R=302,L,NE]

  # Canonical CRM host: always use the root Union World domain, without www.
  RewriteCond %{HTTP_HOST} ^www\.unionworld\.com\.br$ [NC]
  RewriteRule ^ https://unionworld.com.br%{REQUEST_URI} [R=301,L,NE]

  # Force HTTPS even when the cPanel toggle is unavailable.
  # X-Forwarded-Proto avoids redirect loops if the request passes through a proxy.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]

  # Preserve CRM links that may still be opened from the public ArtVideo domain.
  RewriteCond %{HTTP_HOST} ^(?:www\.)?eletronicaartvideo\.com\.br$ [NC]
  RewriteRule ^admin(?:/.*)?$ https://unionworld.com.br%{REQUEST_URI} [R=302,L,NE]

  RewriteCond %{HTTP_HOST} ^(?:www\.)?eletronicaartvideo\.com\.br$ [NC]
  RewriteRule ^captura(?:/.*)?$ https://unionworld.com.br%{REQUEST_URI} [R=302,L,NE]

  RewriteCond %{HTTP_HOST} ^(?:www\.)?eletronicaartvideo\.com\.br$ [NC]
  RewriteRule ^editar-os-mobile/?$ https://unionworld.com.br%{REQUEST_URI} [R=302,L,NE]

  RewriteCond %{HTTP_HOST} ^(?:www\.)?eletronicaartvideo\.com\.br$ [NC]
  RewriteRule ^checklist-mobile/?$ https://unionworld.com.br%{REQUEST_URI} [R=302,L,NE]

  RewriteCond %{HTTP_HOST} ^(?:www\.)?eletronicaartvideo\.com\.br$ [NC]
  RewriteRule ^assinatura(?:/.*)?$ https://unionworld.com.br%{REQUEST_URI} [R=302,L,NE]

  RewriteCond %{HTTP_HOST} ^(?:www\.)?eletronicaartvideo\.com\.br$ [NC]
  RewriteRule ^verificar-documento(?:/.*)?$ https://unionworld.com.br%{REQUEST_URI} [R=302,L,NE]

  # CRM root always opens the administrative login/application.
  RewriteCond %{HTTP_HOST} ^unionworld\.com\.br$ [NC]
  RewriteRule ^$ /admin [R=302,L]

  # Build assets are content-hashed. If an old tab requests an asset that was
  # removed by a newer deploy, let Apache return a real 404 instead of serving
  # index.html with the wrong MIME type. The app can then recover/reload cleanly.
  RewriteRule ^assets/ - [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
